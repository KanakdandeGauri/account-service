# Account service configuration. Every value has a default in application.yml.

PORT=8081

# This service's own database (separate DB and credentials from every other service)
DB_URL=jdbc:postgresql://localhost:5434/account_db
DB_USERNAME=account_user
DB_PASSWORD=account_pass
DB_POOL_SIZE=30

# atomic (always) or naive (deliberately broken, only for the Challenge 1 "before" demo)
HOLD_STRATEGY=atomic
NAIVE_DELAY_MS=50

# Logging: logstash (JSON, default) or ecs
LOG_FORMAT=logstash
LOG_LEVEL=INFO
